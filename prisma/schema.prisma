generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Blogs {
  id           Int      @id @default(autoincrement())
  title        String   @unique
  description  String
  content      String?
  thumbnailImg String
  images       String[]
  tags         String[]
  category     String[]
  show         Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  slug         String   @unique
  authorName   String

  @@index([slug])
  @@index([show])
  @@index([createdAt])
  @@index([show, createdAt])
}

model Admin {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  password      String
  resetOtp      String?   @unique
  otpExpiry     DateTime?
  access_token  String?
  refresh_token String?

  @@index([email])
}

model Contact {
  id         Int      @id @default(autoincrement())
  first_name String
  last_name  String
  phone      String
  email      String   @unique
  message    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([email])
  @@index([createdAt])
}

model SEO {
  id          Int      @id @default(autoincrement())
  route       String   @unique
  title       String?
  description String?
  keywords    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([route])
}

model FAQ {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status    Boolean  @default(false)

  @@index([createdAt])
}

model Vacancies {
  id               Int            @id @default(autoincrement())
  JobTitle         String
  Job_Description  String
  Min_exp          Int
  Max_exp          Int
  Job_type         Job_type
  Salary           String?
  Primary_Skills   String[]
  Secondary_Skills String[]
  Show             Boolean
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  applications     Applications[] @relation("VacancyResponses")
}

model Applications {
  id            Int       @id @default(autoincrement())
  applicantName String
  email         String
  phoneNo       Int
  applied_for   Int
  start_date    DateTime
  qualification String[]
  cover_letter  String?
  resume        String
  status        Status
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  vacancy       Vacancies @relation("VacancyResponses", fields: [applied_for], references: [id])
}

model Skills {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model Category {
  id            Int      @id @default(autoincrement())
  category_name String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category_name])
}

enum Job_type {
  FULL_TIME
  PART_TIME
  CONTRACT
  FREELANCE
  INTERNSHIP
}

enum Status {
  pending
  accepted
  rejected
}
model Cookies {
  id       String  @id @default(uuid()) @db.Uuid
  ip       String?
  location Json?
  browser  Json?
  os       Json?
  device   Json?
  cpu      Json?
  engine   Json?
  ua       String?
  isBot    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}